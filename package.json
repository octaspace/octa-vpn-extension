{
  "name": "octa-vpn",
  "displayName": "OCTA VPN",
  "version": "1.0.0",
  "description": "OCTA VPN Browser Extension",
  "author": "",
  "scripts": {
    "dev": "plasmo dev --verbose",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && plasmo build",
    "firefox": "tsc --noEmit && plasmo build --target=firefox-mv2 --hoist --zip",
    "test": "plasmo test"
  },
  "dependencies": {
    "@emotion/react": "11.11.1",
    "@mantine/core": "6.0.21",
    "@mantine/form": "^7.3.2",
    "@mantine/hooks": "6.0.21",
    "@mantine/notifications": "6.0.21",
    "@octaspace/sdk": "^0.1.1",
    "@phosphor-icons/react": "^2.1.10",
    "@plasmohq/storage": "1.8.0",
    "country-flag-icons": "^1.5.9",
    "node-fetch": "2.6.7",
    "plasmo": "^0.90.5",
    "pnpm": "^10.28.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-icons": "^4.12.0",
    "react-remark": "^2.1.0",
    "react-router-dom": "^6.30.3"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.0",
    "@types/chrome": "0.0.243",
    "@types/node": "20.5.0",
    "@types/react": "18.2.20",
    "@types/react-dom": "18.2.7",
    "prettier": "3.0.2",
    "svgo": "^3.3.3",
    "typescript": "5.8.3"
  },
  "manifest": {
    "browser_specific_settings": {
      "gecko": {
        "id": "octavpn@octa.space",
        "strict_min_version": "91.1.0"
      }
    },
    "permissions": [
      "proxy",
      "identity"
    ],
    "host_permissions": [
      "https://api.octa.space/*",
      "https://api.octa.computer/*",
      "https://ifconfig.octa.computer/*"
    ],
    "key": ""
  }
}

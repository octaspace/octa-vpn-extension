{
  "name": "octa-vpn",
  "displayName": "OCTA VPN",
  "version": "0.0.1",
  "description": "OCTA VPN for browsers",
  "author": "",
  "scripts": {
    "dev": "plasmo dev --verbose",
    "build": "plasmo build --target=firefox-mv2",
    "firefox": "plasmo build --target=firefox-mv2 --hoist --zip",
    "test": "plasmo test"
  },
  "dependencies": {
    "@emotion/react": "11.11.1",
    "@mantine/core": "6.0.21",
    "@mantine/form": "^7.3.2",
    "@mantine/hooks": "6.0.21",
    "@mantine/notifications": "6.0.21",
    "@octaspace/api.js": "^1.0.3",
    "@plasmohq/storage": "1.8.0",
    "country-flag-icons": "^1.5.9",
    "plasmo": "0.84.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-icons": "^4.12.0",
    "react-remark": "^2.1.0",
    "react-router-dom": "6.23.1"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.0",
    "@types/chrome": "0.0.243",
    "@types/node": "20.5.0",
    "@types/react": "18.2.20",
    "@types/react-dom": "18.2.7",
    "prettier": "3.0.2",
    "typescript": "5.1.6"
  },
  "manifest": {
    "browser_specific_settings": {
      "gecko": {
        "id": "octavpn@octa.space",
        "strict_min_version": "91.1.0"
      }
    },
    "permissions": [
      "proxy"
    ],
    "host_permissions": [
      "https://api.octa.space/v1/*",
      "https://ifconfig.octa.computer/*",
      "https://raw.githubusercontent.com/octaspace/octaspace/main/tos_octavpn.md"
    ]
  }
}
